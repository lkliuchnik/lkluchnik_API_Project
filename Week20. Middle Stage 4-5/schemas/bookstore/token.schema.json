{
  "$id": "bookstore/token",
  "description": "POST /Account/v1/GenerateToken - a successful login: the token, when it expires, and the status. New fields are allowed.",
  "type": "object",
  "required": ["token", "expires", "status", "result"],
  "properties": {
    "token": { "type": "string", "minLength": 1 },
    "expires": { "type": "string", "format": "date-time" },
    "status": { "const": "Success" },
    "result": { "type": "string" }
  }
}
