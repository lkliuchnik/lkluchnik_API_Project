# Local settings for the tests. Copy this file to .env and fill in the values:
#   cp .env.example .env
# .env is in .gitignore - real values never go into git.
# In CI the same names come from the workflow: TEST_ENV from the matrix, the passwords from
# GitHub Secrets (Settings > Secrets and variables > Actions).

# Which environment to run: dev (default) or staging - see config/environments.ts
TEST_ENV=dev

# Required: the password of the DummyJSON test user of each environment.
# dev uses the user "emilys", staging the user "michaelw" (public demo users of dummyjson.com,
# their passwords are on https://dummyjson.com/docs/auth).
DUMMYJSON_PASSWORD_DEV=
DUMMYJSON_PASSWORD_STAGING=

# Optional overrides - leave them out to use the values from config/environments.ts
# DUMMYJSON_URL=https://dummyjson.com
# BOOKSTORE_URL=https://demoqa.com
# PETSTORE_URL=https://petstore.swagger.io/v2
